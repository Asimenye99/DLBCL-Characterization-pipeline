        cp results/proteins/wildtype/*.fasta results/structure_inputs/
        cp results/mutant_proteins/*.fasta results/structure_inputs/
        touch results/structure_inputs/.done
        """


############################################################
# 17. FETCH ALPHAFOLD WILD-TYPE STRUCTURES
#     One structure per DLBCL driver gene (canonical UniProt
#     isoform), pulled from the AlphaFold DB. Requires
#     internet access on the node running this rule.
############################################################

rule fetch_alphafold_structure:
    output:
        "results/structures/{gene}.pdb"
    wildcard_constraints:
        gene="[^/]+"
    params:
        uniprot=lambda wc: uniprot_of(wc.gene),
        url=lambda wc: (
            f"https://alphafold.ebi.ac.uk/files/"
            f"AF-{uniprot_of(wc.gene)}-F1-model_v6.pdb"
        )
    log: "logs/alphafold/{gene}.log"
    shell:
        """
        mkdir -p results/structures logs/alphafold

        # The AlphaFold file server returns HTTP 403 to curl's default
        # user agent, so a browser-style agent is sent. Only HTTP 404 (no
        # model in AlphaFold DB, e.g. proteins too large for one model) is
        # accepted as "no structure"; any other failure stops the run
        # instead of silently writing an empty file.
        code=$(curl -sSL -A "Mozilla/5.0" --retry 3 --retry-delay 5 \
                   -o {output} -w "%{{http_code}}" {params.url} 2> {log} || true)

        if [ "$code" = "200" ] && [ -s {output} ]; then
            echo "Downloaded {wildcards.gene} from {params.url}" >> {log}
        elif [ "$code" = "404" ]; then
            echo "NOT_IN_ALPHAFOLD {wildcards.gene} ({params.url}, HTTP 404)" >> {log}
            : > {output}
        else
            echo "ERROR: HTTP $code for {wildcards.gene} ({params.url})" >> {log}
            rm -f {output}
            exit 1
        fi
        """


############################################################
# 18. REPAIR STRUCTURES WITH FOLDX
#     FoldX RepairPDB fixes clashes/torsion issues before
#     BuildModel; required precursor for reliable ddG.
#     rotabase.txt must sit alongside the PDB in the working
#     directory FoldX is run from. - i did not use rotabase cause FOLDX5.1 does not have that
############################################################

rule foldx_repair_pdb:
    input:
        pdb="results/structures/{gene}.pdb"
    output:
        "results/foldx/repair/{gene}_Repair.pdb"
    params:
        foldx=config["foldx_bin"],
        workdir="results/foldx/repair"
    log:
        "logs/foldx/{gene}.repair.log"
    shell:
        """
        mkdir -p {params.workdir} logs/foldx

        # Skip genes with no downloaded structure
        if [ ! -s {input.pdb} ]; then
            echo "No AlphaFold structure available for {wildcards.gene}. Skipping RepairPDB." > {log}
            touch {output}
            exit 0
        fi

        cp {input.pdb} {params.workdir}/

        {params.foldx} --command=RepairPDB \
            --pdb={wildcards.gene}.pdb \
            --pdb-dir={params.workdir} \
            --output-dir={params.workdir} \
            > {log} 2>&1
        """


############################################################
# 19. BUILD FOLDX MUTATION LISTS
#     Converts prioritized HGVS protein changes (e.g.
#     TP53:p.Arg175His) per gene into FoldX's individual_list
#     format (e.g. "RA175H;"), one file per gene since a
#     gene's variants share one structure.
############################################################

rule generate_foldx_mutation_list:
    input:
        variants=MODELLING_VARIANTS,
        canonical_map=ENSP_MAP,
        pdb="results/structures/{gene}.pdb"

    output:
        "results/foldx/mutation_lists/{gene}_individual_list.txt"

    log:
        "logs/foldx/{gene}.mutlist.log"

    shell:
        """
        mkdir -p results/foldx/mutation_lists logs/foldx

        python scripts/generate_foldx_mutation_list.py \
            --variants {input.variants} \
            --canonical-map {input.canonical_map} \
            --gene {wildcards.gene} \
            --gene-col GENE \
            --protein-col HGVSp \
            --chain A \
            --output {output} \
            > {log} 2>&1

        # Drop mutations whose wild-type residue is not in the AlphaFold
        # structure (isoform/numbering mismatch); they are listed in
        # results/foldx/unmodelled/{wildcards.gene}.tsv and reported as not modelled.
        # (Not a declared output, so existing genes are not re-run.)
        mkdir -p results/foldx/unmodelled
        python scripts/filter_foldx_mutations.py \
            --pdb {input.pdb} --mutlist {output} \
            --unmodelled results/foldx/unmodelled/{wildcards.gene}.tsv --gene {wildcards.gene} \
            >> {log} 2>&1
        """

############################################################
# 20. FOLDX BUILDMODEL
#     Introduces each variant onto the repaired wild-type
#     structure and reports ddG (kcal/mol) per mutation.
#
#     FoldX writes:
#         Raw_*.fxout
#         Dif_*.fxout
#         Average_*.fxout
#         PdbList_*.fxout
#
#     We explicitly track:
#         - Average_*.fxout (used for ΔΔG analysis)
#         - individual_list.txt (used to map FoldX output
#           back to the original mutations)
############################################################

rule foldx_build_model:
    input:
        pdb="results/foldx/repair/{gene}_Repair.pdb",
        mutlist="results/foldx/mutation_lists/{gene}_individual_list.txt"

    output:
        average="results/foldx/buildmodel/{gene}/Average_{gene}_Repair.fxout",
        mutlist_copy="results/foldx/buildmodel/{gene}/individual_list.txt"

    params:
        foldx=config["foldx_bin"],
        runs=config.get("foldx_num_runs", 5)

    log:
        "logs/foldx/{gene}.buildmodel.log"

    shell:
        r"""
        OUTDIR=results/foldx/buildmodel/{wildcards.gene}

        mkdir -p "$OUTDIR" logs/foldx

        # Skip if no repaired structure exists
        if [ ! -s "{input.pdb}" ]; then
            echo "No repaired structure for {wildcards.gene}" > "{log}"
            touch "{output.average}"
            touch "{output.mutlist_copy}"
            exit 0
        fi

        # Skip if there are no mutations
        if [ ! -s "{input.mutlist}" ]; then
            echo "No mutation list for {wildcards.gene}" > "{log}"
            touch "{output.average}"
            touch "{output.mutlist_copy}"
            exit 0
        fi

        cp "{input.pdb}" "$OUTDIR/"
        cp "{input.mutlist}" "{output.mutlist_copy}"

        "{params.foldx}" \
            --command=BuildModel \
            --pdb={wildcards.gene}_Repair.pdb \
            --pdb-dir="$OUTDIR" \
            --mutant-file="{output.mutlist_copy}" \
            --output-dir="$OUTDIR" \
            --numberOfRuns={params.runs} \
            > "{log}" 2>&1

        test -f "{output.average}"
        """


############################################################
# 21. CLASSIFY STRUCTURAL/STABILITY EFFECTS
#     Parses FoldX Average_*.fxout files produced by
#     BuildModel and classifies each mutation according to
#     ΔΔG:
#
#       destabilizing : ΔΔG > 0.5 kcal/mol
#       stabilizing   : ΔΔG < -0.5 kcal/mol
#       neutral       : -0.5 <= ΔΔG <= 0.5 kcal/mol
#
#     The original FoldX mutation lists are used to map
#     FoldX mutation IDs back to the corresponding variants.
############################################################

rule classify_stability:
    input:
        average_fxout=lambda wc: expand(
            "results/foldx/buildmodel/{gene}/Average_{gene}_Repair.fxout",
            gene=modelled_genes()
        ),
        mutation_lists=lambda wc: expand(
            "results/foldx/mutation_lists/{gene}_individual_list.txt",
            gene=modelled_genes()
        )

    output:
        "results/structural_effects/DLBCL_structural_effects.tsv"

    params:
        genes=lambda wc: " ".join(modelled_genes()),
        buildmodel_dir="results/foldx/buildmodel",
        mutation_dir="results/foldx/mutation_lists",
        destabilizing_threshold=0.5,
        stabilizing_threshold=-0.5

    log:
        "logs/foldx/classify_stability.log"

    shell:
        """
        mkdir -p results/structural_effects logs/foldx

        python scripts/classify_ddg.py \
            --buildmodel-dir {params.buildmodel_dir} \
            --mutation-dir {params.mutation_dir} \
            --genes {params.genes} \
            --destabilizing-threshold {params.destabilizing_threshold} \
            --stabilizing-threshold {params.stabilizing_threshold} \
            --output {output} \
            > {log} 2>&1
        """
        
