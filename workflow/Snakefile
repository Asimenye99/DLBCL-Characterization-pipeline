import os
import pandas as pd

configfile: "config/config.yaml"

samples = pd.read_csv("samples.tsv", sep="\t")
SAMPLES = samples["sample"].tolist()


def get_fastq(wc, read):
    return samples.loc[samples["sample"] == wc.sample, read].values[0]


############################################################
# GENE LISTS AND ID MAPS (derived from the data)
#
# Variant calling and annotation are exome-wide; no gene panel filters
# variants. Gene scope is applied downstream, after annotation:
#   cancer-associated genes = COSMIC Cancer Gene Census (config: cosmic_census)
#   DLBCL context           = Reddy et al. (2017) driver genes (IN_DLBCL_LIST)
# Each variant is labelled GENE_SET = Both | Census_only | Reddy_only | Neither.
# Candidate variants are pathogenic-evidence variants (Level 1-3) in genes of
# the Census or the Reddy list. Gene membership is an annotation, never
# evidence of pathogenicity. The genes to model structurally are derived by
# the build_gene_maps checkpoint from the missense candidates, with UniProt
# (VEP SWISSPROT) and canonical ENSP taken from VEP.
############################################################

DLBCL_GENES = config["dlbcl_driver_genes"]   # Reddy et al. 2017 (annotation)
CENSUS = config["cosmic_census"]             # COSMIC Cancer Gene Census CSV

PATHOGENIC_VARIANTS = "results/prioritization/pathogenic_variants.tsv"
# Candidate variants: Level 1-3 evidence in a Census or Reddy gene
CANDIDATE_VARIANTS = "results/prioritization/candidate_variants.tsv"
# Truncating candidates (characterised separately; not FoldX input)
TRUNCATING_VARIANTS = "results/prioritization/truncating_variants.tsv"
FUNNEL = "results/prioritization/summary/funnel_summary.tsv"
# Missense candidates (FoldX input): Level 1, plus Level 3 in Reddy or Census Tier 1 genes
MODELLING_VARIANTS = "results/prioritization/modelling_variants.tsv"
# Candidate rows in genes altered in >= pathway_min_samples patients (STRING/enrichment input)
PATHWAY_VARIANTS = "results/prioritization/pathway_variants.tsv"
GENE_LIST = "results/prioritization/modelling_genes.txt"
UNIPROT_MAP = "results/prioritization/uniprot_map.tsv"
ENSP_MAP = "results/prioritization/canonical_ensp_map.tsv"


def modelled_genes(wildcards=None):
    checkpoints.build_gene_maps.get()
    with open(GENE_LIST) as fh:
        return [line.strip() for line in fh if line.strip()]


def uniprot_of(gene):
    checkpoints.build_gene_maps.get()
    df = pd.read_csv(UNIPROT_MAP, sep="\t")
    return df.set_index("gene")["uniprot_id"].to_dict()[gene]


def structure_targets(wildcards):
    genes = modelled_genes()
    return (
        expand("results/structures/{gene}.pdb", gene=genes)
        + expand("results/foldx/mutation_lists/{gene}_individual_list.txt", gene=genes)
        + expand("results/foldx/buildmodel/{gene}/Average_{gene}_Repair.fxout", gene=genes)
        + expand("results/foldx/repair/{gene}_Repair.pdb", gene=genes)
    )


############################################################
# ALL TARGETS
############################################################

rule all:
    input:
        expand("results/bam/{sample}.marked.bam", sample=SAMPLES),
        expand("results/mutect/{sample}.normalized.vcf.gz", sample=SAMPLES),
        expand("results/mutect/{sample}.normalized.vcf.gz.tbi", sample=SAMPLES),
        expand("results/annotation/{sample}.vep.vcf", sample=SAMPLES),
        expand("results/haplotypecaller/{sample}.normalized.vcf.gz", sample=SAMPLES),
        expand("results/haplotypecaller/{sample}.normalized.vcf.gz.tbi", sample=SAMPLES),
        expand("results/annotation_hc/{sample}.vep.vcf", sample=SAMPLES),
        "results/prioritization/DLBCL_candidate_variants.tsv",
        PATHOGENIC_VARIANTS,
        MODELLING_VARIANTS,
        PATHWAY_VARIANTS,
        CANDIDATE_VARIANTS,
        TRUNCATING_VARIANTS,
        FUNNEL,
        "results/pathways/background_genes.txt",
        "results/proteins/protein_sequences_done.flag",
        "results/mutant_proteins/mutant_sequences_done.flag",
        "results/structure_inputs",
        structure_targets,

        "results/structural_effects/DLBCL_structural_effects.tsv",
        "results/pathways/string_network.tsv",
        "results/pathways/network_analysis.tsv",
        "results/pathways/reactome_enrichment.tsv",
        "results/pathways/kegg_enrichment.tsv",
        "results/pathways/go_enrichment.tsv",
        "results/pathways/ppi_network.png",
        "results/pathways/pathway_summary.html",
        "results/multiqc/multiqc_report.html"


############################################################
# 0. REFERENCE INDEXING
#    bwa index / .fai / .dict are prerequisites for
#    alignment and GATK. Generated here so the pipeline
#    is self-contained rather than assuming they pre-exist.
############################################################

rule bwa_index:
    input:
        config["reference"]
    output:
        config["reference"] + ".bwt",
        config["reference"] + ".pac",
        config["reference"] + ".ann",
        config["reference"] + ".amb",
        config["reference"] + ".sa"
    log: "logs/bwa_index.log"
    shell:
        """
        bwa index {input} > {log} 2>&1
        """

rule faidx:
    input:
        config["reference"]
    output:
        config["reference"] + ".fai"
    log: "logs/faidx.log"
    shell:
        """
        samtools faidx {input} > {log} 2>&1
        """

rule sequence_dict:
    input:
        config["reference"]
    output:
        os.path.splitext(config["reference"])[0] + ".dict"
    log: "logs/sequence_dict.log"
    shell:
        """
        gatk CreateSequenceDictionary -R {input} -O {output} > {log} 2>&1
        """


############################################################
# 1. RAW READ QUALITY CONTROL
############################################################

rule fastqc:
    input:
        R1=lambda wc: get_fastq(wc, "R1"),
        R2=lambda wc: get_fastq(wc, "R2")
    output:
        html1="results/fastqc/{sample}_1_fastqc.html",
        zip1="results/fastqc/{sample}_1_fastqc.zip",
        html2="results/fastqc/{sample}_2_fastqc.html",
        zip2="results/fastqc/{sample}_2_fastqc.zip"
    threads: config["threads"]["fastqc"]
    log: "logs/fastqc/{sample}.log"
    shell:
        """
        mkdir -p results/fastqc logs/fastqc
        fastqc {input.R1} {input.R2} -t {threads} -o results/fastqc > {log} 2>&1
        """


############################################################
# 2. READ TRIMMING
############################################################

rule trim:
    input:
        R1=lambda wc: get_fastq(wc, "R1"),
        R2=lambda wc: get_fastq(wc, "R2")
    output:
        R1="results/trim/{sample}_1.paired.fastq.gz",
        R2="results/trim/{sample}_2.paired.fastq.gz",
        R1_unpaired=temp("results/trim/{sample}_1.unpaired.fastq.gz"),
        R2_unpaired=temp("results/trim/{sample}_2.unpaired.fastq.gz")
    threads: config["threads"]["trimmomatic"]
    resources:
        mem_mb=32000
    log: "logs/trim/{sample}.log"
    shell:
        """
        mkdir -p results/trim logs/trim
        export JAVA_TOOL_OPTIONS="-Xmx32G"

        trimmomatic PE -threads {threads} \
            {input.R1} {input.R2} \
            {output.R1} {output.R1_unpaired} \
            {output.R2} {output.R2_unpaired} \
            ILLUMINACLIP:{config[trimmomatic][adapters]}:2:30:10 \
            LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20 MINLEN:36 \
            > {log} 2>&1
        """

############################################################
# 3. QUALITY CONTROL AFTER TRIMMING
############################################################

rule fastqc_trimmed:
    input:
        R1="results/trim/{sample}_1.paired.fastq.gz",
        R2="results/trim/{sample}_2.paired.fastq.gz"
    output:
        html1="results/fastqc_trimmed/{sample}_1.paired_fastqc.html",
        zip1="results/fastqc_trimmed/{sample}_1.paired_fastqc.zip",
        html2="results/fastqc_trimmed/{sample}_2.paired_fastqc.html",
        zip2="results/fastqc_trimmed/{sample}_2.paired_fastqc.zip"
    threads: config["threads"]["fastqc"]
    log: "logs/fastqc_trimmed/{sample}.log"
    shell:
        """
        mkdir -p results/fastqc_trimmed logs/fastqc_trimmed
        fastqc {input.R1} {input.R2} -t {threads} -o results/fastqc_trimmed > {log} 2>&1
        """


############################################################
# 4. BWA-MEM ALIGNMENT + SORTING
#    Produces sorted BAM directly; adds read groups
#    required by GATK
############################################################

rule align_sort:
    input:
        ref=config["reference"],
        bwt=config["reference"] + ".bwt",
        R1="results/trim/{sample}_1.paired.fastq.gz",
        R2="results/trim/{sample}_2.paired.fastq.gz"
    output:
        bam="results/bam/{sample}.sorted.bam",
        bai="results/bam/{sample}.sorted.bam.bai"
    threads: config["threads"]["bwa"]
    log: "logs/bwa/{sample}.log"
    benchmark: "benchmarks/bwa/{sample}.txt"
    params:
        rg=lambda wc: f"@RG\\tID:{wc.sample}\\tSM:{wc.sample}\\tPL:ILLUMINA\\tLB:{wc.sample}"
    shell:
        """
        mkdir -p results/bam logs/bwa
        bwa mem -t {threads} -R '{params.rg}' {input.ref} {input.R1} {input.R2} 2> {log} \
            | samtools sort -@ {threads} -o {output.bam}
        samtools index {output.bam}
        """


############################################################
# 5. MARK DUPLICATES
############################################################

rule mark_duplicates:
    input:
        "results/bam/{sample}.sorted.bam"
    output:
        bam="results/bam/{sample}.marked.bam",
        bai="results/bam/{sample}.marked.bam.bai",
        metrics="results/bam/{sample}.metrics.txt"
    log: "logs/markduplicates/{sample}.log"
    shell:
        """
        mkdir -p logs/markduplicates
        gatk MarkDuplicates -I {input} -O {output.bam} -M {output.metrics} > {log} 2>&1
        samtools index {output.bam}
        """


############################################################
# 6. MUTECT2 SOMATIC VARIANT CALLING (TUMOR ONLY)
#    Designed for DLBCL tumor samples without matched normal
#
#    --af-of-alleles-not-in-resource is set explicitly because
#    the GATK default (0.001) assumes a small germline resource.
#    For a gnomAD-scale resource (~125,000+ samples) the
#    documented recommendation is roughly 1 / (2 x N_samples),
#    i.e. ~4e-6. Without this, Mutect2/FilterMutectCalls
#    over-flags real somatic variants as "germline" -- an
#    effect that is worse for cohorts under-represented in
#    gnomAD (e.g. African-ancestry samples), since their
#    variants are more likely to look "novel" against the
#    reference panel. Override via config["mutect2"]["af_not_in_resource"]
#    if your germline resource has a different sample count.
############################################################

rule mutect2:
    input:
        bam="results/bam/{sample}.marked.bam",
        bai="results/bam/{sample}.marked.bam.bai",
        ref=config["reference"],
        fai=config["reference"] + ".fai",
        seq_dict=os.path.splitext(config["reference"])[0] + ".dict",
        germline=config["germline_resource"]
    output:
        vcf="results/mutect/{sample}.unfiltered.vcf.gz",
        f1r2="results/mutect/{sample}.f1r2.tar.gz"
    threads: config["threads"]["gatk"]
    log: "logs/mutect2/{sample}.log"
    benchmark: "benchmarks/mutect2/{sample}.txt"
    params:
        pon=lambda wc: (
            f"--panel-of-normals {config['panel_of_normals']}"
            if config.get("panel_of_normals") else ""
        ),
        af_not_in_resource=config.get("mutect2", {}).get(
            "af_not_in_resource", "4e-6"
        ),
        intervals=lambda wc: (
            f"-L {config['target_intervals']} --interval-padding 100"
            if config.get("target_intervals") else ""
        )
    shell:
        """
        mkdir -p results/mutect logs/mutect2
        gatk Mutect2 \
            -R {input.ref} \
            -I {input.bam} \
            --germline-resource {input.germline} \
            --af-of-alleles-not-in-resource {params.af_not_in_resource} \
            {params.pon} \
            {params.intervals} \
            --f1r2-tar-gz {output.f1r2} \
            --native-pair-hmm-threads {threads} \
            -O {output.vcf} \
            > {log} 2>&1
        """


############################################################
# 7. LEARN READ ORIENTATION ARTIFACT MODEL
############################################################

rule orientation_model:
    input:
        "results/mutect/{sample}.f1r2.tar.gz"
    output:
        "results/mutect/{sample}.read-orientation-model.tar.gz"
    log: "logs/mutect2/{sample}.orientation.log"
    shell:
        """
        gatk LearnReadOrientationModel -I {input} -O {output} > {log} 2>&1
        """


############################################################
# 8. CONTAMINATION ESTIMATION
############################################################

rule get_pileup_summaries:
    input:
        bam="results/bam/{sample}.marked.bam",
        bai="results/bam/{sample}.marked.bam.bai",
        variants=config["common_variants"]
    output:
        "results/mutect/{sample}.pileups.table"
    log: "logs/mutect2/{sample}.pileup.log"
    shell:
        """
        gatk GetPileupSummaries \
            -I {input.bam} \
            -V {input.variants} \
            -L {input.variants} \
            -O {output} \
            > {log} 2>&1
        """


rule calculate_contamination:
    input:
        "results/mutect/{sample}.pileups.table"
    output:
        contamination="results/mutect/{sample}.contamination.table",
        segments="results/mutect/{sample}.segments.table"
    log: "logs/mutect2/{sample}.contamination.log"
    shell:
        """
        gatk CalculateContamination \
            -I {input} \
            -O {output.contamination} \
            --tumor-segmentation {output.segments} \
            > {log} 2>&1
        """


############################################################
# 9. FILTER SOMATIC VARIANTS
############################################################

rule filter_mutect:
    input:
        vcf="results/mutect/{sample}.unfiltered.vcf.gz",
        ref=config["reference"],
        fai=config["reference"] + ".fai",
        seq_dict=os.path.splitext(config["reference"])[0] + ".dict",
        contamination="results/mutect/{sample}.contamination.table",
        segments="results/mutect/{sample}.segments.table",
        orientation="results/mutect/{sample}.read-orientation-model.tar.gz"
    output:
        "results/mutect/{sample}.filtered.vcf.gz"
    log: "logs/mutect2/{sample}.filter.log"
    shell:
        """
        gatk FilterMutectCalls \
            -R {input.ref} \
            -V {input.vcf} \
            --contamination-table {input.contamination} \
            --tumor-segmentation {input.segments} \
            --ob-priors {input.orientation} \
            -O {output} \
            > {log} 2>&1
        """


############################################################
# 10. NORMALIZE VARIANTS
#     Important before VEP annotation
############################################################

rule normalize_vcf:
    input:
        vcf="results/mutect/{sample}.filtered.vcf.gz",
        ref=config["reference"],
        fai=config["reference"] + ".fai"
    output:
        vcf="results/mutect/{sample}.normalized.vcf.gz",
        tbi="results/mutect/{sample}.normalized.vcf.gz.tbi"
    log: "logs/bcftools/{sample}.norm.log"
    shell:
        """
        mkdir -p logs/bcftools
        bcftools norm -f {input.ref} -m -both {input.vcf} -Oz -o {output.vcf} > {log} 2>&1
        tabix -p vcf {output.vcf}
        """


############################################################
# 11. VEP ANNOTATION
#     Adds: gene symbol, transcript consequence, ClinVar,
#     CADD, REVEL, AlphaMissense
############################################################

rule vep:
    input:
        "results/mutect/{sample}.normalized.vcf.gz"

    output:
        vcf="results/annotation/{sample}.vep.vcf",
        stats="results/annotation/{sample}.vep_summary.html"

    threads: config["threads"]["vep"]

    log:
        "logs/vep/{sample}.log"

    benchmark:
        "benchmarks/vep/{sample}.txt"

    params:
        clinvar=config["vep_plugins"]["clinvar_vcf"]

    shell:
        """
        module load Miniconda3/23.9.0-0
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate vep115_env
        
        export PERL5LIB="$CONDA_PREFIX/share/ensembl-vep-115.2-1:${{PERL5LIB:-}}"
        mkdir -p results/annotation logs/vep

        vep \
            -i {input} \
            -o {output.vcf} \
            --vcf \
            --cache \
            --offline \
            --dir_cache {config[vep_cache]} \
            --dir_plugins {config[vep_plugins_dir]} \
            --assembly GRCh38 \
            --fasta reference/GRCh38.fa \
            --symbol \
            --canonical \
            --protein \
            --hgvsp \
            --hgvs \
            --pick \
            --everything \
            --fork {threads} \
            --stats_file {output.stats} \
            --custom {params.clinvar},ClinVar,vcf,exact,0,CLNSIG,CLNSIGCONF,CLNREVSTAT,CLNDN \
            --plugin CADD,{config[vep_plugins][cadd_snv]} \
            --plugin REVEL,{config[vep_plugins][revel]} \
            --plugin AlphaMissense,file=reference/AlphaMissense/AlphaMissense_hg38.tsv.gz \
            --force_overwrite \
            > {log} 2>&1
        """


############################################################
# 11A. HAPLOTYPECALLER (GERMLINE-STYLE CALLING ON THE TUMOR BAM)
#
#      Complements Mutect2. HaplotypeCaller is a germline
#      caller: it reports variants of all origins present in
#      the tumor sample and cannot tell germline from somatic
#      without a matched normal, so its calls are labelled
#      "Unresolved" downstream. Mutect2 remains the source of
#      the putative-somatic / germline-flagged inference.
#
#      Optional config key:
#          target_intervals   exome capture BED / interval_list.
#                             Strongly recommended: without it
#                             the whole reference is traversed.
#                             A 100 bp padding is applied.
############################################################

rule haplotypecaller:
    input:
        bam="results/bam/{sample}.marked.bam",
        bai="results/bam/{sample}.marked.bam.bai",
        ref=config["reference"],
        fai=config["reference"] + ".fai",
        seq_dict=os.path.splitext(config["reference"])[0] + ".dict"
    output:
        vcf="results/haplotypecaller/{sample}.raw.vcf.gz",
        tbi="results/haplotypecaller/{sample}.raw.vcf.gz.tbi"
    threads: config["threads"]["gatk"]
    log: "logs/haplotypecaller/{sample}.log"
    benchmark: "benchmarks/haplotypecaller/{sample}.txt"
    params:
        intervals=lambda wc: (
            f"-L {config['target_intervals']} --interval-padding 100"
            if config.get("target_intervals") else ""
        )
    shell:
        """
        mkdir -p results/haplotypecaller logs/haplotypecaller
        gatk HaplotypeCaller \
            -R {input.ref} \
            -I {input.bam} \
            {params.intervals} \
            --native-pair-hmm-threads {threads} \
            -O {output.vcf} \
            > {log} 2>&1
        """


############################################################
# 11B. HARD-FILTER HAPLOTYPECALLER CALLS
#      VQSR is not suitable for a small number of exomes, so
#      GATK's recommended hard filters are applied separately
#      to SNPs and indels, then merged. Failing calls are
#      labelled in the FILTER column (not removed); the
#      prioritisation script accepts only PASS / '.'.
#      MNP and mixed-type records are not selected and are
#      therefore not carried forward.
#      Thresholds follow GATK's germline hard-filter
#      guidance; adjust if justified by the data.
############################################################

rule filter_haplotypecaller:
    input:
        vcf="results/haplotypecaller/{sample}.raw.vcf.gz",
        tbi="results/haplotypecaller/{sample}.raw.vcf.gz.tbi",
        ref=config["reference"],
        fai=config["reference"] + ".fai",
        seq_dict=os.path.splitext(config["reference"])[0] + ".dict"
    output:
        vcf="results/haplotypecaller/{sample}.filtered.vcf.gz",
        tbi="results/haplotypecaller/{sample}.filtered.vcf.gz.tbi"
    log: "logs/haplotypecaller/{sample}.filter.log"
    shell:
        """
        set -euo pipefail
        mkdir -p results/haplotypecaller logs/haplotypecaller
        exec > {log} 2>&1

        TMP=results/haplotypecaller/{wildcards.sample}

        gatk SelectVariants \
            -R {input.ref} -V {input.vcf} \
            --select-type-to-include SNP \
            -O ${{TMP}}.snps.vcf.gz

        gatk SelectVariants \
            -R {input.ref} -V {input.vcf} \
            --select-type-to-include INDEL \
            -O ${{TMP}}.indels.vcf.gz

        gatk VariantFiltration \
            -R {input.ref} -V ${{TMP}}.snps.vcf.gz \
            --filter-name "SNP_QUAL30"   --filter-expression "QUAL < 30.0" \
            --filter-name "SNP_QD2"      --filter-expression "QD < 2.0" \
            --filter-name "SNP_FS60"     --filter-expression "FS > 60.0" \
            --filter-name "SNP_SOR3"     --filter-expression "SOR > 3.0" \
            --filter-name "SNP_MQ40"     --filter-expression "MQ < 40.0" \
            --filter-name "SNP_MQRS-12.5" --filter-expression "MQRankSum < -12.5" \
            --filter-name "SNP_RPRS-8"   --filter-expression "ReadPosRankSum < -8.0" \
            -O ${{TMP}}.snps.filtered.vcf.gz

        gatk VariantFiltration \
            -R {input.ref} -V ${{TMP}}.indels.vcf.gz \
            --filter-name "INDEL_QUAL30" --filter-expression "QUAL < 30.0" \
            --filter-name "INDEL_QD2"    --filter-expression "QD < 2.0" \
            --filter-name "INDEL_FS200"  --filter-expression "FS > 200.0" \
            --filter-name "INDEL_SOR10"  --filter-expression "SOR > 10.0" \
            --filter-name "INDEL_RPRS-20" --filter-expression "ReadPosRankSum < -20.0" \
            -O ${{TMP}}.indels.filtered.vcf.gz

        gatk MergeVcfs \
            -I ${{TMP}}.snps.filtered.vcf.gz \
            -I ${{TMP}}.indels.filtered.vcf.gz \
            -O {output.vcf}

        rm -f ${{TMP}}.snps.vcf.gz ${{TMP}}.snps.vcf.gz.tbi \
              ${{TMP}}.indels.vcf.gz ${{TMP}}.indels.vcf.gz.tbi \
              ${{TMP}}.snps.filtered.vcf.gz ${{TMP}}.snps.filtered.vcf.gz.tbi \
              ${{TMP}}.indels.filtered.vcf.gz ${{TMP}}.indels.filtered.vcf.gz.tbi
        """


############################################################
# 11C. NORMALIZE HAPLOTYPECALLER VARIANTS
############################################################

rule normalize_haplotypecaller:
    input:
        vcf="results/haplotypecaller/{sample}.filtered.vcf.gz",
        ref=config["reference"],
        fai=config["reference"] + ".fai"
    output:
        vcf="results/haplotypecaller/{sample}.normalized.vcf.gz",
        tbi="results/haplotypecaller/{sample}.normalized.vcf.gz.tbi"
    log: "logs/bcftools/{sample}.hc.norm.log"
    shell:
        """
        mkdir -p logs/bcftools
        bcftools norm -f {input.ref} -m -both {input.vcf} -Oz -o {output.vcf} > {log} 2>&1
        tabix -p vcf {output.vcf}
        """


############################################################
# 11D. VEP ANNOTATION OF HAPLOTYPECALLER VARIANTS
#      Identical options to rule vep (keep the two in sync);
#      output goes to results/annotation_hc/ so that sample
#      names are preserved and the two callers stay separate
#      until the prioritisation step.
############################################################

rule vep_haplotypecaller:
    input:
        "results/haplotypecaller/{sample}.normalized.vcf.gz"

    output:
        vcf="results/annotation_hc/{sample}.vep.vcf",
        stats="results/annotation_hc/{sample}.vep_summary.html"

    threads: config["threads"]["vep"]

    log:
        "logs/vep/{sample}.hc.log"

    benchmark:
        "benchmarks/vep/{sample}.hc.txt"

    params:
        clinvar=config["vep_plugins"]["clinvar_vcf"]

    shell:
        """
        module load Miniconda3/23.9.0-0
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate vep115_env
        
        export PERL5LIB="$CONDA_PREFIX/share/ensembl-vep-115.2-1:${{PERL5LIB:-}}"
        mkdir -p results/annotation_hc logs/vep

        vep \
            -i {input} \
            -o {output.vcf} \
            --vcf \
            --cache \
            --offline \
            --dir_cache {config[vep_cache]} \
            --dir_plugins {config[vep_plugins_dir]} \
            --assembly GRCh38 \
            --fasta reference/GRCh38.fa \
            --symbol \
            --canonical \
            --protein \
            --hgvsp \
            --hgvs \
            --pick \
            --everything \
            --fork {threads} \
            --stats_file {output.stats} \
            --custom {params.clinvar},ClinVar,vcf,exact,0,CLNSIG,CLNSIGCONF,CLNREVSTAT,CLNDN \
            --plugin CADD,{config[vep_plugins][cadd_snv]} \
            --plugin REVEL,{config[vep_plugins][revel]} \
            --plugin AlphaMissense,file=reference/AlphaMissense/AlphaMissense_hg38.tsv.gz \
            --force_overwrite \
            > {log} 2>&1
        """


############################################################
# 12. VARIANT PRIORITIZATION (GERMLINE AND SOMATIC)
#     Exome-wide: every protein-altering variant in any gene is
#     annotated and tiered. The Census (IN_CGC, CGC_TIER) and Reddy
#     (IN_DLBCL_LIST) lists only label genes (GENE_SET); candidates
#     are variants with Level 1-3 evidence in either list. Evidence:
#     ClinVar pathogenicity, HIGH impact and computational predictors.
#
#     Outputs:
#       DLBCL_candidate_variants.tsv  all protein-altering variants
#                                     passing FILTER and --max-af
#       pathogenic_variants.tsv       rows with pathogenic evidence
#                                     (ClinVar P/LP, HIGH-impact LoF,
#                                     or CADD/REVEL/AlphaMissense)
#
#     Inputs:
#       Mutect2 calls        FILTER PASS / . / germline
#       HaplotypeCaller      FILTER PASS / . (hard-filtered),
#                            ORIGIN=Unresolved unless Mutect2 agrees.
#     Variants found by both callers are merged into one row.
#     --max-af removes common variants unless ClinVar reports
#     pathogenic/likely pathogenic (config["max_af"], default 0.01).
############################################################

rule prioritize_variants:
    input:
        mutect=expand("results/annotation/{sample}.vep.vcf", sample=SAMPLES),
        hc=expand("results/annotation_hc/{sample}.vep.vcf", sample=SAMPLES),
        census=CENSUS
    output:
        candidates="results/prioritization/DLBCL_candidate_variants.tsv",
        pathogenic=PATHOGENIC_VARIANTS,
        modelling=MODELLING_VARIANTS,
        pathway=PATHWAY_VARIANTS,
        candidates_primary=CANDIDATE_VARIANTS,
        truncating=TRUNCATING_VARIANTS
    log: "logs/prioritization.log"
    params:
        flag_genes=",".join(config["dlbcl_driver_genes"]),
        max_af=config.get("max_af", 0.01),
        cadd=config["thresholds"]["cadd_phred"],
        revel=config["thresholds"]["revel"],
        am=config["thresholds"]["alphamissense_pathogenicity"],
        min_predictors=config.get("min_predictors", 1),
        census_tiers=" ".join(str(t) for t in config.get("modelling_census_tiers", [1])),
        levels=" ".join(str(l) for l in config.get("candidate_levels", [1])),
        pathway_min_samples=config.get("pathway_min_samples", 1)
    shell:
        """
        mkdir -p results/prioritization logs
        python scripts/prioritize_variants.py \
            --vcfs {input.mutect} \
            --hc-vcfs {input.hc} \
            --flag-genes "{params.flag_genes}" \
            --census {input.census} \
            --modelling-census-tiers {params.census_tiers} \
            --candidate-levels {params.levels} \
            --candidate-output {output.candidates_primary} \
            --truncating-output {output.truncating} \
            --output {output.candidates} \
            --pathogenic-output {output.pathogenic} \
            --modelling-output {output.modelling} \
            --pathway-output {output.pathway} \
            --pathway-min-samples {params.pathway_min_samples} \
            --include-filters PASS . germline \
            --hc-include-filters PASS . \
            --max-af {params.max_af} \
            --cadd-phred {params.cadd} \
            --revel {params.revel} \
            --alphamissense {params.am} \
            --min-predictors {params.min_predictors} \
            > {log} 2>&1
        """


############################################################
# 12B. FUNNEL COUNTS, GENE-SET OVERLAP, CANDIDATE VARIANT TABLE
############################################################

